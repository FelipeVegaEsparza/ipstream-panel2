# =====================================================
# CasterFly Panel — .env.prod.example
# =====================================================
# Copiar a .env en el VPS y completar con valores reales.
# chmod 600 .env  (importante: contiene secretos)
#
# Generar secretos con:
#   openssl rand -base64 32   # NEXTAUTH_SECRET
#   openssl rand -hex 32      # ENCRYPTION_KEY
#   openssl rand -hex 32      # STREAMING_AGENT_TOKEN
#   openssl rand -hex 20      # passwords de MySQL / Icecast
# =====================================================

# === Dominios ===
# El DNS A de cada host debe apuntar a la IP del VPS.
# Sitio público (stack PHP/MySQL "site"):
PUBLIC_DOMAIN=casterfly.com
# Panel Next.js + APIs:
PANEL_DOMAIN=panel.casterfly.com
# Stream de audio (Icecast detrás de Caddy):
STREAM_DOMAIN=stream.casterfly.com
# Dominios anteriores durante la transición. No los borres hasta actualizar
# las PWA instaladas y los nodos remotos.
LEGACY_PANEL_DOMAIN=panelipstream.cl
LEGACY_STREAM_DOMAIN=stream.panelipstream.cl
LEGACY_PUBLIC_DOMAIN=ipstream.cl

# === Sitios de clientes (bundle único de la PWA + dominios) ===
# Los sitios de clientes viven en <cliente>.casterfly.com.
# DNS: registro A wildcard *.casterfly.com → TU_IP.
CLIENT_SITES_DOMAIN=casterfly.com
# Destino del CNAME que los clientes deben configurar para su dominio propio
# (p. ej. CNAME radio.cliente.com → clientes.casterfly.com).
CLIENT_SITES_TARGET=clientes.casterfly.com
# IP de la plataforma (alternativa al CNAME si se prefieren registros A).
CLIENT_SITES_IP=
# Token de API de Cloudflare para la provisión automática de subdominios.
# Permisos mínimos: Zone:DNS:Edit sobre la zona de CLIENT_SITES_DOMAIN
# (casterfly.com).
CLOUDFLARE_API_TOKEN=

# === GitHub Container Registry (lo setea el deploy.sh) ===
# GITHUB_REPOSITORY_OWNER=tu-usuario-github
# IMAGE_TAG=main  (o un SHA específico)

# === Base de datos ===
MYSQL_ROOT_PASSWORD=CAMBIAR_random_20_chars_hex
MYSQL_DATABASE=ipstream_panel
MYSQL_USER=ipstream
MYSQL_PASSWORD=CAMBIAR_random_20_chars_hex

# === NextAuth ===
# URL público (con https, sin puerto porque Caddy hace de proxy)
NEXTAUTH_URL=https://panel.casterfly.com
# URL pública del panel para Server Actions y enlaces generados.
PANEL_PUBLIC_URL=https://panel.casterfly.com
# Host que usan los nodos remotos para alcanzar la DB central (:3307).
PANEL_PUBLIC_HOST=panel.casterfly.com
# 32+ chars random
NEXTAUTH_SECRET=CAMBIAR_openssl_rand_base64_32

# === Encriptación AES-256-GCM (32 bytes hex = 64 chars) ===
ENCRYPTION_KEY=CAMBIAR_openssl_rand_hex_32

# === Admin seed (se crea al primer arranque) ===
ADMIN_EMAIL=admin@casterfly.com
ADMIN_PASSWORD=CAMBIAR_password_fuerte
ADMIN_NAME="Administrador Principal"

# === Streaming Agent ===
# Token compartido entre el panel y el agent. DEBE ser el mismo
# en ambos lados (panel .env y agent .env).
STREAMING_AGENT_TOKEN=CAMBIAR_openssl_rand_hex_32
# Token secreto para los callbacks de harbor de Liquidsoap.
# Generar con: openssl rand -hex 32
HARBOR_CALLBACK_SECRET=CAMBIAR_openssl_rand_hex_32
# Orígenes permitidos para CORS (separados por coma).
# Incluye el panel nuevo y el viejo mientras existan nodos/PWA sin actualizar.
CORS_ALLOWED_ORIGINS=https://panel.casterfly.com,https://panelipstream.cl

# === Consola web de radio (Transmitir en vivo) ===
# Secreto compartido panel/agente para tokens de sesión. Si queda vacío,
# se usa STREAMING_AGENT_TOKEN como fallback.
LIVE_SESSION_SECRET=
# Bitrate del puente hacia Liquidsoap (la salida final también debe ser 192k).
LIVE_AUDIO_BITRATE=192
# mp3 (seguro) o aac (solo si el harbor lo acepta; ver spike de calidad).
LIVE_BRIDGE_CODEC=mp3
# Transporte por defecto: whip (WebRTC) o websocket (fallback).
LIVE_TRANSPORT_DEFAULT=whip
# STUN/TURN adicionales en JSON. Ej: [{"urls":"stun:stun.l.google.com:19302"}]
LIVE_ICE_SERVERS=[]
# Opcional. Si está vacío se usa NEXTAUTH_URL / publicUrl del servidor.
LIVE_PUBLIC_BASE_URL=
# IP pública del VPS que SRS anuncia como candidato ICE (usar IP, no DNS).
# IMPORTANTE: abrir el puerto UDP 8010 en el firewall del VPS.
RTC_CANDIDATE=
SRS_RTC_UDP_PORT=8010
# Fallback automático al AutoDJ cuando la fuente en vivo queda en silencio.
RADIO_SILENCE_FALLBACK_SECONDS=10
RADIO_SILENCE_THRESHOLD_DB=-50
RADIO_SILENCE_COOLDOWN_SECONDS=30

# === Subida de video de TV ===
# Tamaño máximo de subida de un video de TV, en MB (default 2048).
MAX_VIDEO_UPLOAD_MB=2048
# Timeout de ffmpeg para normalizar video, en ms (0 = sin límite).
FFMPEG_TIMEOUT_MS=0
# Preset de x264 del re-encode de normalización (ultrafast/veryfast = menos CPU).
FFMPEG_PRESET=ultrafast
# Hilos por job de normalización (0 = auto).
FFMPEG_THREADS=0
# Modo de playout de TV: stitch (VOD2Live, recomendado) | concat (legacy).
TV_PLAYOUT=stitch

# === Icecast ===
ICE_ADMIN_USER=admin
ICE_ADMIN_PASSWORD=CAMBIAR_random_20_chars_hex
ICE_SOURCE_PASSWORD=CAMBIAR_random_20_chars_hex
ICE_RELAY_PASSWORD=CAMBIAR_random_20_chars_hex
# Hostname interno del container (no tocar)
ICE_HOSTNAME=localhost
# URL público del stream (HTTPS, vía Caddy)
# El panel y el player embebido van a usar esta URL.
# Caddy proxy stream.casterfly.com:443 → icecast:8000 (interno)
ICE_PUBLIC_URL=https://stream.casterfly.com
# Puerto público del stream (lo escuchan los oyentes)
ICE_PUBLIC_PORT=443
HARBOR_PUBLIC_HOSTNAME=stream.casterfly.com
# Host de ingesta de TV (RTMP): rtmp://panel.casterfly.com:1935/relay
RTMP_RELAY_PUBLIC_HOST=panel.casterfly.com

# === Email (Resend) ===
# Verificá el dominio casterfly.com en Resend antes de usar este remitente.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@casterfly.com
RESEND_WEBHOOK_SECRET=

# === Cron (opcional, vacío = sin auth en endpoints de cron). ===
# En producción se recomienda setear un token para proteger los endpoints /api/cron/*.
CRON_SECRET=

# === OneSignal (push web) ===
# Secreto del webhook de clicks de OneSignal. Debe coincidir con el header
# Authorization: Bearer ... configurado en la app de cada cliente en OneSignal.
# Requerido para que /api/webhook/onesignal cuente clicks (sin él responde 500).
ONESIGNAL_WEBHOOK_SECRET=
