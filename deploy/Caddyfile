# =====================================================
# IPStream Panel — Caddyfile
# =====================================================
# Reverse proxy + HTTPS automático con Let's Encrypt.
#
# Configuración:
#   - panelipstream.cl      → Panel Next.js (HTTPS, :443)
#   - stream.panelipstream.cl → Icecast (HTTPS, :443, proxy a :8000)
#
# IMPORTANTE: configurá tu DNS ANTES de levantar Caddy.
# Registros A requeridos:
#   - panelipstream.cl        → TU_IP
#   - stream.panelipstream.cl → TU_IP
# =====================================================

# ============================================================
# Opciones globales
# ============================================================
# TLS on-demand para los sitios de clientes (dominios no listados abajo).
# `ask` autoriza la emisión de certificados solo para dominios registrados y
# activos en el panel. Caddy consulta el endpoint con ?domain=<host>.
{
	on_demand_tls {
		ask http://app:3000/api/domains/ask
	}
}

# ============================================================
# Panel principal: panelipstream.cl
# ============================================================
{$STREAM_DOMAIN:panelipstream.cl} {
    # === Panel Next.js (puerto interno 3000) ===
    reverse_proxy app:3000

    # === Headers de seguridad ===
    header {
        # HSTS (incluye subdominios)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Anti-clickjacking
        X-Frame-Options "SAMEORIGIN"
        # Anti-MIME-sniffing
        X-Content-Type-Options "nosniff"
        # Referrer
        Referrer-Policy "strict-origin-when-cross-origin"
        # Quitar header del server (no leak de versión)
        -Server
    }

    # === HLS streaming (proxy a SRS) ===
    # AutoDJ se sirve en /live/* y el DJ en vivo en /dj/*
    # CORS: los sitios de los clientes consumen el HLS cross-origin (Web
    # Audio / video). Los .m3u8 y segmentos .ts se sirven desde acá.
    handle /live/* {
        header {
            Access-Control-Allow-Origin "*"
            Access-Control-Allow-Methods "GET, OPTIONS, HEAD"
            Access-Control-Allow-Headers "Range, Content-Type"
            Access-Control-Expose-Headers "Content-Length, Content-Type"
        }
        reverse_proxy srs:8080
    }

    handle /dj/* {
        header {
            Access-Control-Allow-Origin "*"
            Access-Control-Allow-Methods "GET, OPTIONS, HEAD"
            Access-Control-Allow-Headers "Range, Content-Type"
            Access-Control-Expose-Headers "Content-Length, Content-Type"
        }
        reverse_proxy srs:8080
    }

    # === Logging ===
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

# HTTP -> HTTPS redirect (panel)
http://{$STREAM_DOMAIN:panelipstream.cl} {
    redir https://{$STREAM_DOMAIN:panelipstream.cl}{uri} permanent
}

# ============================================================
# Stream (Icecast): stream.panelipstream.cl
# ============================================================
# Proxy HTTPS al Icecast interno (puerto 8000).
# Esto da HTTPS al audio stream — algunos navegadores y players
# requieren HTTPS para mixed content o por seguridad.
stream.{$STREAM_DOMAIN:panelipstream.cl} {
    # Proxy al Icecast
    reverse_proxy icecast:8000

    # === Headers específicos para audio streaming ===
    header {
        # CORS para que el player embebido funcione desde cualquier dominio
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, OPTIONS"
        Access-Control-Allow-Headers "Range, Content-Type, Icy-MetaData"
        Access-Control-Expose-Headers "Content-Length, Content-Type, Icy-Br, Icy-MetaInt, Icy-MetaData"

        # Caching
        Cache-Control "no-cache, no-store, must-revalidate"

        # Icecast-specific (para que se vea en players)
        # Icecast 2.x ya envía estos headers, pero por las dudas
        -Server
    }

    # Streaming pasa por HTTPS y se desfasa en chunks.
    # Importante: NO comprimir (rompe el streaming)
    encode zstd gzip

    # === Logging ===
    log {
        output file /data/stream-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

# HTTP -> HTTPS redirect (stream)
http://stream.{$STREAM_DOMAIN:panelipstream.cl} {
    redir https://stream.{$STREAM_DOMAIN:panelipstream.cl}{uri} permanent
}

# ============================================================
# Sitios de clientes (bundle único de la PWA)
# ============================================================
# Catch-all: cualquier host que no matchee los bloques de arriba (subdominios
# de plataforma tipo <cliente>.panelipstream.cl y dominios custom) se sirve
# como sitio de cliente. El header X-Tenant-Site hace que el middleware del
# panel enrute al shell dinámico. TLS on-demand acotado por el endpoint `ask`:
# solo se emiten certificados para dominios registrados y activos.
:443 {
    tls {
        on_demand
    }

    header X-Tenant-Site "1"

    reverse_proxy app:3000

    log {
        output file /data/sites-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
