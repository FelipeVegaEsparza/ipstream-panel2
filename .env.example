# =====================================================
# IPStream Panel — Variables de entorno (Docker / local)
# Copiar a .env y completar valores sensibles antes de usar.
# =====================================================

# --- Base de datos ---
# Docker (docker-compose): la app habla con el servicio "db" por la red interna (puerto 3306):
DATABASE_URL="mysql://ipstream:ipstream_secret@db:3306/ipstream_panel?schema=public&charset=utf8mb4"
# Desarrollo local (app corriendo en el host, MySQL en docker):
# docker-compose publica MySQL en el puerto 3307 del host:
# DATABASE_URL="mysql://ipstream:ipstream_secret@localhost:3307/ipstream_panel?schema=public&charset=utf8mb4"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production-please-32chars-min"

# --- GitHub Container Registry ---
# El namespace donde se publican las imagenes (normalmente el usuario o
# la org dueña del repo). El deploy.sh lo usa para hacer docker compose pull.
GITHUB_REPOSITORY_OWNER=tu-usuario-o-org

# --- Panel ---
# Dominio público del panel (sin protocolo). Lo usa Next.js para
# validar Server Actions cuando hay un proxy reverso (Caddy).
PANEL_PUBLIC_URL="https://panel.tudominio.com"

# Procesos worker del panel (cluster). Vacío = CPUs del VPS - 1.
# Ej: en un VPS de 4 vCPU, dejarlo vacío usa 3; forzar 2 si hay streaming activo.
WEB_CONCURRENCY=

# TTL (ms) de la caché en proceso del contenido público de la PWA (noticias,
# programas, etc.). 0 desactiva la caché. Default 10000 (10 s).
PUBLIC_CONTENT_CACHE_TTL_MS=10000

# Host (IP o dominio) por el que los nodos de streaming alcanzan la DB central
# (MySQL expuesta en :3307). Si está vacío, se deriva de NEXTAUTH_URL.
PANEL_PUBLIC_HOST=""

# --- Sitios de clientes (bundle único de la PWA + dominios) ---
# Dominio base de los subdominios de plataforma. Un cliente registrado como
# "radio-x" se resuelve desde "radio-x.<CLIENT_SITES_DOMAIN>" cuando este valor
# es, por ejemplo, "panelipstream.cl". Vacío = no se resuelve por etiqueta.
CLIENT_SITES_DOMAIN=""
# Destino del CNAME para dominios custom y para los registros de subdominio.
CLIENT_SITES_TARGET=""
# IP de la plataforma (alternativa al CNAME si se usan registros A).
CLIENT_SITES_IP=""
# Token de Cloudflare (Zone:DNS:Edit) para crear subdominios automáticamente.
# Si está vacío, se asume un wildcard DNS *.CLIENT_SITES_DOMAIN.
CLOUDFLARE_API_TOKEN=""

# --- PayPal (pago online en USD) ---
# Credenciales de una app REST de PayPal. Sin ellas, el botón "Pagar con PayPal"
# no se muestra (el resto de la facturación sigue igual). PayPal no soporta CLP:
# solo se ofrece para monedas soportadas (USD, EUR, …); CLP queda por transferencia.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox" # "sandbox" | "live"
# Id del webhook de PayPal (para verificar la firma). Endpoint: {PANEL}/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=""

# Email que recibe las notificaciones del panel (nuevos registros de clientes).
ADMIN_NOTIFY_EMAIL=""

# URL p\u00fablica del stream de TV (la que se muestra en el dashboard de
# television y es compartible). Si est\u00e1 vac\u00eda, se usa el path
# relativo (funciona dentro del panel via Next.js rewrite).
# Ejemplos:
#   NEXT_PUBLIC_STREAM_PUBLIC_URL="https://panel.tudominio.cl"
#   NEXT_PUBLIC_STREAM_PUBLIC_URL="https://stream.tudominio.cl"
NEXT_PUBLIC_STREAM_PUBLIC_URL="https://stream.tudominio.cl"

# --- Encriptación AES-256-GCM (lib/encryption.ts) ---
# Clave de 32 bytes en hex (64 chars). Generar con: openssl rand -hex 32
# (también se acepta base64 de 32 bytes, pero hex es lo recomendado)
ENCRYPTION_KEY="REEMPLAZAR_POR_HEX_DE_64_CARACTERES_GENERADO_CON_OPENSSL_RAND_HEX_32"

# --- Cron jobs ---
# Si está definido, /api/cron/chat/cleanup y /api/cron/send-pending-notifications
# exigirán Authorization: Bearer ${CRON_SECRET}. Si está vacío, no exigen auth (útil en dev).
CRON_SECRET=""

# --- OneSignal (push web) ---
# Secreto del webhook de clicks de OneSignal. Debe coincidir con el header
# Authorization: Bearer ... configurado en la app de cada cliente en OneSignal.
# Sin él, /api/webhook/onesignal no puede verificar la petición y no cuenta clicks.
ONESIGNAL_WEBHOOK_SECRET=""

# --- Admin seed (creado automáticamente por el entrypoint si no existe) ---
ADMIN_EMAIL="admin@ipstream.com"
ADMIN_PASSWORD="admin123456"
ADMIN_NAME="Administrador Principal"

# --- Node ---
NODE_ENV="production"

# --- Streaming (Icecast) ---
ICE_ADMIN_USER="admin"
ICE_ADMIN_PASSWORD="change-me-ice-admin"
ICE_SOURCE_PASSWORD="change-me-ice-source"
ICE_RELAY_PASSWORD="change-me-ice-relay"
ICE_HOSTNAME="stream.tudominio.com"
ICE_PUBLIC_PORT="8000"
ICE_PUBLIC_URL="https://stream.tudominio.com"
# Hostname público que los DJs deben usar para conectar al harbor de Liquidsoap.
# Debe resolver a la máquina donde corre el contenedor de Liquidsoap.
HARBOR_PUBLIC_HOSTNAME="stream.tudominio.com"
# Host público para la URL de ingesta "Conexión Universal" de Televisión
# (rtmp://<host>:1935/relay). Usar el mismo host del panel.
RTMP_RELAY_PUBLIC_HOST="panel.tudominio.com"

# --- Streaming Agent (sidecar que controla icecast + liquidsoap) ---
STREAMING_AGENT_URL="http://agent:4000"
STREAMING_AGENT_TOKEN="change-me-agent-token-32-chars-minimum"

# --- Consola web de radio (Transmitir en vivo) ---
# Clave compartida panel/agente para firmar tokens de sesión. Generar con openssl rand -hex 32.
# Si queda vacía, se usa STREAMING_AGENT_TOKEN como fallback.
LIVE_SESSION_SECRET=""
# Bitrate del puente hacia Liquidsoap. La salida final también debe ser 192k.
LIVE_AUDIO_BITRATE="192"
# 'mp3' (seguro) o 'aac' (solo si input.harbor acepta AAC; ver spike de calidad).
LIVE_BRIDGE_CODEC="mp3"
AUDIO_BRIDGE_CONTAINER="ipstream-audio-bridge"
# Puerto UDP de SRS para WebRTC. Debe abrirse en el firewall del nodo.
SRS_RTC_UDP_PORT="8010"
# IP pública que SRS anuncia como candidato ICE. Usar IP, no DNS.
RTC_CANDIDATE=""
# JSON de servidores ICE/TURN adicionales, ej: [{"urls":"stun:stun.l.google.com:19302"}]
LIVE_ICE_SERVERS="[]"
# Transporte por defecto: 'whip' o 'websocket'.
LIVE_TRANSPORT_DEFAULT="whip"
# URL pública del nodo para WHIP/WS. Si está vacía se usa el publicUrl del servidor.
LIVE_PUBLIC_BASE_URL=""

# --- Email (Resend) ---
# API key de Resend (https://resend.com/api-keys). Si está vacía, no se envían correos.
RESEND_API_KEY=""
# Remitente: debe usar un dominio verificado en Resend (ej: no-reply@ipstream.cl)
RESEND_FROM_EMAIL="no-reply@ipstream.cl"
# Secreto para verificar los webhooks de Resend (estado de envío). Generar con openssl rand -hex 32
RESEND_WEBHOOK_SECRET=""
