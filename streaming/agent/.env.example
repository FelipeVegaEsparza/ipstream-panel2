# =====================================================
# IPStream Streaming Agent — environment variables
# =====================================================
# Copiar a .env y completar.

# Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production

# Auth: este token se compara contra Authorization: Bearer <token>
# que envía el IPStream Panel. DEBE coincidir con STREAMING_AGENT_TOKEN
# del .env.docker del panel.
STREAMING_AGENT_TOKEN=change-me-agent-token-32-chars-min

# Database (mismo MySQL que el panel)
DB_HOST=db
DB_PORT=3306
DB_USER=ipstream
DB_PASSWORD=ipstream_secret
DB_DATABASE=ipstream_panel
DB_CONNECTION_LIMIT=10

# Icecast
ICE_HOST=icecast
ICE_PORT=8000
ICE_ADMIN_USER=admin
ICE_ADMIN_PASSWORD=hackme

# Liquidsoap
LIQUIDSOAP_BIN=/usr/bin/liquidsoap
LIQUIDSOAP_SCRIPTS_PATH=/etc/liquidsoap/scripts
LIQUIDSOAP_LOG_PATH=/var/log/liquidsoap
LIQUIDSOAP_TELNET_BASE_PORT=12340
LIQUIDSOAP_HOST=ipstream-liquidsoap

# Radio library (volumen compartido con liquidsoap)
RADIO_LIBRARY_PATH=/var/lib/radio
