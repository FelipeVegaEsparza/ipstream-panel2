// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("CLIENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con cliente
  client Client?

  @@map("users")
}

model Client {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String
  planId          String?
  templateId      String?
  oneSignalAppId  String? // OneSignal App ID
  oneSignalApiKey String?  @db.Text // OneSignal REST API Key (encriptada)
  useGenericNews  Boolean  @default(false)
  phone           String? // Número de WhatsApp (con código de país, ej: 56912345678)
  timezone        String   @default("UTC")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   Plan?                   @relation(fields: [planId], references: [id], onDelete: SetNull)
  template               Template?               @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subscription           Subscription?
  basicData              BasicData?
  socialNetworks         SocialNetworks?
  programs               Program[]
  news                   News[]
  rankingVideos          RankingVideo[]
  sponsors               Sponsor[]
  promotions             Promotion[]
  podcasts               Podcast[]
  payments               Payment[]
  pushNotifications      PushNotification[]
  galleries              Gallery[]
  announcers             Announcer[]
  polls                  Poll[]
  events                 Event[]
  pwaInstalls            PwaInstall[]
  genericCategories      GlobalNewsCategory[]
  menuItems              ClientMenuItem[]
  supportTickets         SupportTicket[]
  chatMessages           ChatMessage[]
  chatBans               ChatBan[]
  // Streaming — Audio (Radio)
  radioStream            RadioStream?
  tracks                 Track[]
  playlists              Playlist[]
  streamingAuditLogs     StreamingAuditLog[]
  jingles                Jingle[]
  playlistSchedules      PlaylistSchedule[]
  streamStats            StreamStat[]
  folders                Folder[]
  djSessions             DjSession[]
  // Streaming — Video (Televisión)
  videoStream            VideoStream?
  videoTracks            VideoTrack[]
  videoPlaylists         VideoPlaylist[]
  videoPlaylistEntries   VideoPlaylistEntry[]
  videoPlaylistSchedules VideoPlaylistSchedule[]
  emailLogs              EmailLog[]

  @@map("clients")
}

model BasicData {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  projectName        String
  projectDescription String   @db.Text
  logoUrl            String?
  coverUrl           String?
  websiteUrl         String?  @db.VarChar(500)
  radioStreamingUrl  String?
  videoStreamingUrl  String?
  city               String?
  region             String?
  country            String?
  latitude           Float?
  longitude          Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("basic_data")
}

model SocialNetworks {
  id        String   @id @default(cuid())
  clientId  String   @unique
  facebook  String?
  youtube   String?
  instagram String?
  tiktok    String?
  whatsapp  String?
  x         String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("social_networks")
}

model Program {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  imageUrl    String?
  description String   @db.Text
  startTime   String // Format: "HH:MM"
  endTime     String // Format: "HH:MM"
  weekDays    String // JSON array: ["monday", "tuesday", ...]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("programs")
}

model News {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  slug      String
  shortText String   @db.Text
  longText  String   @db.LongText
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, slug])
  @@map("news")
}

model RankingVideo {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  videoUrl    String
  description String   @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("ranking_videos")
}

model Sponsor {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  logoUrl     String?
  address     String?
  description String   @db.Text
  facebook    String?
  youtube     String?
  instagram   String?
  tiktok      String?
  whatsapp    String?
  x           String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("sponsors")
}

model Promotion {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  description String   @db.Text
  imageUrl    String?
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("promotions")
}

model Event {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  description String   @db.Text
  date        DateTime
  time        String? // Formato: "HH:MM"
  location    String?
  eventUrl    String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("events")
}

model Podcast {
  id            String   @id @default(cuid())
  clientId      String
  title         String
  description   String   @db.Text
  imageUrl      String?
  audioUrl      String? // URL del archivo de audio
  videoUrl      String? // URL del archivo de video
  fileType      String // "audio" | "video"
  duration      String? // Duración del episodio (ej: "45:30")
  episodeNumber Int? // Número de episodio (opcional)
  season        String? // Temporada (opcional)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("podcasts")
}

model Announcer {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  description String   @db.Text
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("announcers")
}

model Poll {
  id        String   @id @default(cuid())
  clientId  String
  title     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  options PollOption[]

  @@map("polls")
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  text   String
  votes  Int    @default(0)

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@map("poll_options")
}

model PwaInstall {
  id        String   @id @default(cuid())
  clientId  String
  deviceId  String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, deviceId])
  @@map("pwa_installs")
}

model Gallery {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  images GalleryImage[]

  @@map("galleries")
}

model GalleryImage {
  id        String   @id @default(cuid())
  galleryId String
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@map("gallery_images")
}

// Modelos para sistema de pagos y planes
model Plan {
  id                  String   @id @default(cuid())
  name                String   @unique
  description         String   @db.Text
  price               Float
  currency            String   @default("CLP")
  imageUrl            String? // imagen del plan (para la página de registro)
  interval            String // "monthly" | "yearly"
  features            String   @db.Text // JSON array de características
  isActive            Boolean  @default(true)
  maxDjs              Int      @default(4) // Máximo de DJs simultáneos por radio. NULL no soportado.
  // Servicios incluidos en el plan: "radio" | "tv" | "both"
  services            String   @default("both")
  // Secciones del dashboard que el plan NO incluye (JSON array de MenuItemKey).
  // Se fusiona con services: services oculta la sección entera (Radio/TV) y
  // menuHiddenKeys permite ocultar items puntuales. null = todas incluidas.
  menuHiddenKeys      String?  @db.Text
  // Servidor de streaming por defecto de este plan (los streams del cliente
  // se crean ahí al contratarlo). null = servidor principal/global.
  defaultServerId     String?
  // Cuotas de almacenamiento (MB) del plan; null = ilimitado.
  // Se aplican a RadioStream.storageQuotaMB / VideoStream.storageQuotaMB al asignar el plan.
  radioStorageQuotaMB Int?
  videoStorageQuotaMB Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relaciones
  clients       Client[]
  subscriptions Subscription[]
  defaultServer StreamingServer? @relation("PlanDefaultServer", fields: [defaultServerId], references: [id], onDelete: SetNull)

  @@index([defaultServerId])
  @@map("plans")
}

model Subscription {
  id                 String    @id @default(cuid())
  clientId           String    @unique
  planId             String
  status             String // "active" | "cancelled" | "expired" | "pending"
  startDate          DateTime
  endDate            DateTime
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relaciones
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String    @id @default(cuid())
  clientId       String
  subscriptionId String?
  amount         Float
  currency       String    @default("CLP")
  status         String // "pending" | "completed" | "failed" | "refunded"
  paymentMethod  String // "credit_card" | "bank_transfer" | "paypal" | "other"
  transactionId  String?
  description    String?
  receiptUrl     String? // URL del comprobante de pago (imagen o PDF)
  dueDate        DateTime // Fecha de vencimiento del pago (fecha original según ciclo)
  paidAt         DateTime? // Fecha real en que se efectuó el pago
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relaciones
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// Modelo para plantillas de sitio web
model Template {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String // Nombre para mostrar
  description String?  @db.Text
  imageUrl    String? // Preview de la plantilla
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  clients Client[]

  @@map("templates")
}

// Modelo para notificaciones push
model PushNotification {
  id              String    @id @default(cuid())
  clientId        String
  title           String
  message         String    @db.Text
  imageUrl        String?
  targetUrl       String?
  scheduledFor    DateTime? // null = envío inmediato
  sentAt          DateTime?
  status          String // "pending" | "sent" | "failed"
  oneSignalId     String? // ID de la notificación en OneSignal
  recipientsCount Int       @default(0)
  clicksCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relaciones
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("push_notifications")
}

model AppConfig {
  id                   String  @id @default(cuid())
  enableGenericNews    Boolean @default(false)
  loginBackgroundImage String? // URL de la imagen de fondo del login (null = fondo animado por defecto)
  hiddenMenuItems      String? @db.Text // JSON array de MenuItemKey ocultos globalmente (override de per-client)
  adminNotifyEmail     String? // correo que recibe notificaciones del panel (nuevos registros, etc.)

  @@map("app_config")
}

model ClientMenuItem {
  id        String   @id @default(cuid())
  clientId  String
  itemKey   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, itemKey])
  @@index([clientId])
  @@map("client_menu_items")
}

model GlobalNewsCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  news    GlobalNews[]
  clients Client[]

  @@map("global_news_categories")
}

model GlobalNews {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  slug        String   @unique
  shortText   String   @db.Text
  longText    String   @db.LongText
  imageUrl    String?
  imageSource String?  @db.VarChar(100)
  status      String   @default("published")
  source      String   @default("manual")
  aiRunId     String?  @db.VarChar(40)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category GlobalNewsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([aiRunId])
  @@index([categoryId, status])
  @@map("global_news")
}

model TutorialCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tutorials Tutorial[]

  @@map("tutorial_categories")
}

model Tutorial {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  youtubeUrl  String
  categoryId  String
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category TutorialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("tutorials")
}

model SupportTicket {
  id        String    @id @default(cuid())
  clientId  String
  subject   String
  status    String // "open" | "in_progress" | "closed"
  priority  String // "low" | "normal" | "high" | "urgent"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  client      Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages    SupportTicketMessage[]
  attachments SupportTicketAttachment[]

  @@index([clientId])
  @@index([status])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorType String // "client" | "admin"
  authorName String
  authorId   String?
  body       String   @db.Text
  createdAt  DateTime @default(now())

  ticket      SupportTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments SupportTicketAttachment[]

  @@index([ticketId])
  @@map("support_ticket_messages")
}

model SupportTicketAttachment {
  id         String   @id @default(cuid())
  ticketId   String
  messageId  String?
  fileName   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  uploadedBy String // "client" | "admin"
  uploaderId String?
  createdAt  DateTime @default(now())

  ticket  SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message SupportTicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([messageId])
  @@map("support_ticket_attachments")
}

model ChatMessage {
  id         String   @id @default(cuid())
  clientId   String
  authorType String   @default("listener") // "listener" | "staff"
  name       String   @db.VarChar(60)
  email      String?  @db.VarChar(120)
  body       String   @db.VarChar(500)
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("chat_messages")
}

model ChatBan {
  id        String   @id @default(cuid())
  clientId  String
  email     String?  @db.VarChar(120)
  ipAddress String?  @db.VarChar(45)
  reason    String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, email])
  @@index([clientId, ipAddress])
  @@map("chat_bans")
}

// Role values: "ADMIN" | "CLIENT"
// Plan intervals: "monthly" | "yearly"
// Subscription status: "active" | "cancelled" | "expired" | "pending"
// Payment status: "pending" | "completed" | "failed" | "refunded"
// Payment methods: "credit_card" | "bank_transfer" | "paypal" | "other"
// Push notification status: "pending" | "sent" | "failed"
// GlobalNews status: "draft" | "published"
// GlobalNews source: "manual" | "ai"

// =====================================================
// Streaming (Phase 1) — Audio AutoDJ + Biblioteca + Playlists
// =====================================================

// RadioStream es la configuración de la radio de un cliente.
// 1:1 con Client. Contiene la info para que el cliente
// conecte su DJ y para que el streaming-agent sepa qué hacer.
model RadioStream {
  id                   String    @id @default(cuid())
  clientId             String    @unique
  serverId             String? // servidor de streaming asignado (radio)
  // Identificadores de conexión (cómo aparece en Icecast)
  icecastMount         String    @unique // ej: "abc123" (sin slash)
  liquidsoapTelnetPort Int // ej: 12345 (único por servidor)
  // Credenciales encriptadas (AES-256-GCM via lib/encryption.ts)
  sourcePasswordEnc    String    @db.Text // password del AutoDJ (liquidsoap → icecast)
  livePasswordEnc      String    @db.Text // password del DJ en vivo
  // Configuración de audio
  bitrate              Int       @default(128) // kbps
  autoStart            Boolean   @default(false) // iniciar AutoDJ al arrancar el agente
  // === Configuración administrativa (configurable desde /admin/streaming) ===
  enabled              Boolean   @default(true) // kill switch
  storageQuotaMB       Int? // cuota de AutoDJ library en MB (null = ilimitado)
  maxListeners         Int? // cap de oyentes simultáneos (null = ilimitado)
  maxTracksPerPlaylist Int? // ej: 200 (null = ilimitado)
  adminNotes           String?   @db.Text // notas internas del admin
  // Jingles (cuñas publicitarias)
  jinglePlayEvery      Int       @default(5) // cada X canciones
  jinglePlayCount      Int       @default(1) // reproducir Y jingles
  // Estado actual
  status               String    @default("off") // "off" | "autodj" | "live"
  // Stats cacheadas (actualizadas vía WebSocket desde el streaming-agent)
  currentTitle         String?
  currentArtist        String?
  listenerCount        Int       @default(0)
  lastStatusAt         DateTime?
  // Estado interno del proceso liquidsoap (gestionado por streaming-agent)
  liquidsoapRunning    Boolean   @default(false)
  liquidsoapPid        Int?
  liquidsoapStartedAt  DateTime?
  lastError            String?   @db.Text
  // Timestamps
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  server            StreamingServer?   @relation(fields: [serverId], references: [id], onDelete: SetNull)
  tracks            Track[]
  playlists         Playlist[]
  jingles           Jingle[]
  playlistSchedules PlaylistSchedule[]
  streamStats       StreamStat[]
  djs               RadioDj[]
  djSessions        DjSession[]

  @@unique([serverId, liquidsoapTelnetPort])
  @@index([status])
  @@index([enabled])
  @@index([serverId])
  @@map("radio_streams")
}

// RadioDj — Slots de DJ para una radio (máximo 4 por cliente).
// La prioridad define el orden en fallback: priority=1 es el más prioritario.
// Roles: owner > host > guest (owner puede interrumpir a todos, host a guest, guest solo si nadie conectó).
model RadioDj {
  id          String   @id @default(cuid())
  clientId    String
  name        String   @db.VarChar(100) // nombre del DJ / identificador público
  mount       String   @db.VarChar(10) // /dj1, /dj2, /dj3, /dj4
  priority    Int      @default(1) // 1 = más prioritario
  passwordEnc String?  @db.Text // password individual encriptado
  role        String   @default("guest") // "owner" | "host" | "guest"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  radioStream RadioStream @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessions    DjSession[]

  @@unique([clientId, mount])
  @@index([clientId])
  @@map("radio_djs")
}

// DjSession — historial de conexiones de DJs a una radio.
model DjSession {
  id              String    @id @default(cuid())
  clientId        String
  radioStreamId   String
  djId            String
  mount           String    @db.VarChar(10)
  role            String    @db.VarChar(10)
  ipAddress       String?   @db.VarChar(45)
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime  @default(now())

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  radioStream RadioStream @relation(fields: [radioStreamId], references: [id], onDelete: Cascade)
  dj          RadioDj     @relation(fields: [djId], references: [id], onDelete: Cascade)

  @@index([clientId, startedAt])
  @@index([radioStreamId, startedAt])
  @@index([djId])
  @@map("dj_sessions")
}

// Track es un archivo MP3 en la biblioteca de un cliente.
// El filePath apunta a /var/lib/radio/<clientId>/mp3/<fileName>
// dentro del volumen compartido con el container de liquidsoap.
model Track {
  id            String   @id @default(cuid())
  clientId      String
  radioStreamId String
  // Metadatos (leídos de ID3 tags o del nombre de archivo)
  title         String
  artist        String?
  album         String?
  duration      Int? // segundos
  // Archivo físico
  fileName      String // nombre del archivo en el filesystem (sin path)
  filePath      String // ruta absoluta dentro del container liquidsoap
  fileSize      Int // bytes
  coverUrl      String?
  mimeType      String   @default("audio/mpeg")
  uploadedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  folderId    String?
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  radioStream RadioStream     @relation(fields: [radioStreamId], references: [id], onDelete: Cascade)
  entries     PlaylistEntry[]
  folder      Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([radioStreamId])
  @@index([folderId])
  @@index([artist])
  @@index([title])
  @@map("tracks")
}

// Folder — organización de tracks por carpetas.
// Soporta anidación vía parentId para subcarpetas.
model Folder {
  id        String   @id @default(cuid())
  clientId  String
  name      String   @db.VarChar(200)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  parent      Folder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Folder[]     @relation("FolderTree")
  tracks      Track[]
  videoTracks VideoTrack[]

  @@unique([clientId, parentId, name])
  @@index([clientId])
  @@index([parentId])
  @@map("folders")
}

// Playlist es una lista ordenada de tracks para AutoDJ.
// Solo una playlist puede estar activa por RadioStream a la vez.
model Playlist {
  id            String   @id @default(cuid())
  clientId      String
  radioStreamId String
  name          String
  description   String?  @db.Text
  isActive      Boolean  @default(false) // solo una activa por radio
  shuffle       Boolean  @default(false)
  repeat        Boolean  @default(true) // default true para AutoDJ
  // Estadísticas
  totalDuration Int? // segundos, recalculado al cambiar tracks
  trackCount    Int      @default(0)
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  radioStream RadioStream        @relation(fields: [radioStreamId], references: [id], onDelete: Cascade)
  entries     PlaylistEntry[]
  schedules   PlaylistSchedule[]

  @@index([clientId])
  @@index([radioStreamId])
  @@index([isActive])
  @@map("playlists")
}

// PlaylistEntry une Track con Playlist, manteniendo el orden.
model PlaylistEntry {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  order      Int
  createdAt  DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, order])
  @@map("playlist_entries")
}

// Log de auditoría de todas las acciones de streaming.
model StreamingAuditLog {
  id        String   @id @default(cuid())
  clientId  String
  action    String // "stream_start", "stream_stop", "playlist_create",
  // "playlist_activate", "track_upload", "track_delete",
  // "source_switch", "config_update", "error"
  payload   Json?
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([action])
  @@map("streaming_audit_logs")
}

// Jingles (cuñas publicitarias por cliente)
model Jingle {
  id            String   @id @default(cuid())
  clientId      String
  radioStreamId String
  title         String   @db.VarChar(191)
  artist        String?  @db.VarChar(191)
  duration      Float
  fileName      String   @db.VarChar(191)
  filePath      String   @db.VarChar(191)
  fileSize      Int
  coverUrl      String?  @db.VarChar(191)
  mimeType      String   @default("audio/mpeg") @db.VarChar(191)
  uploadedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  radioStream RadioStream @relation(fields: [radioStreamId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([radioStreamId])
  @@map("jingles")
}

// Programación horaria de playlists
model PlaylistSchedule {
  id            String   @id @default(cuid())
  clientId      String
  radioStreamId String
  playlistId    String
  dayOfWeek     Int // 0=domingo, 1=lun, ..., 6=sáb
  startTime     String   @db.VarChar(191) // HH:mm
  endTime       String   @db.VarChar(191) // HH:mm
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  radioStream RadioStream @relation(fields: [radioStreamId], references: [id], onDelete: Cascade)
  playlist    Playlist    @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([clientId, dayOfWeek, isActive])
  @@index([radioStreamId, dayOfWeek, isActive])
  @@map("playlist_schedules")
}

// Estadísticas históricas de oyentes (snapshots periódicos del agente)
model StreamStat {
  id            String   @id @default(cuid())
  clientId      String
  radioStreamId String
  listenerCount Int
  listenerPeak  Int
  currentTitle  String?  @db.VarChar(191)
  currentArtist String?  @db.VarChar(191)
  timestamp     DateTime

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  radioStream RadioStream @relation(fields: [radioStreamId], references: [id], onDelete: Cascade)

  @@index([clientId, timestamp])
  @@index([radioStreamId, timestamp])
  @@map("stream_stats")
}

// ================================================================
// Servidores de streaming — nodos (radio/tv) registrados en el panel
// ================================================================
model StreamingServer {
  id                 String    @id @default(cuid())
  name               String // nombre identificativo (ej: "Radio VPS 1")
  type               String    @default("both") // "radio" | "tv" | "both"
  baseUrl            String // URL del agente (ej: http://agent:4000)
  tokenEnc           String    @db.Text // token de autenticación encriptado (AES-256-GCM)
  publicHostname     String // hostname público para generar URLs de streaming
  publicUrl          String? // URL base pública para oyentes (ej: https://stream.midominio.cl o http://ip:8000). Si es null se deriva del publicHostname
  isActive           Boolean   @default(true)
  isHealthy          Boolean   @default(true) // actualizado por health checks del panel
  lastHealthAt       DateTime? // última vez que el health check tuvo éxito
  // === Provisioning automático (SSH) ===
  sshHost            String? // IP/hostname del nodo para SSH
  sshPort            Int       @default(22)
  sshUser            String    @default("root")
  sshAuthType        String    @default("key") // "key" | "password"
  sshKeyEnc          String?   @db.Text // clave privada encriptada (AES-256-GCM)
  sshPasswordEnc     String?   @db.Text // password encriptado (AES-256-GCM)
  provisionStatus    String    @default("none") // "none" | "provisioning" | "done" | "failed"
  provisionStep      String?
  provisionError     String?   @db.Text
  provisionLog       Json?
  provisionStartedAt DateTime?
  provisionedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  radioStreams RadioStream[]
  videoStreams VideoStream[]
  plans        Plan[]        @relation("PlanDefaultServer")

  @@index([type])
  @@index([isActive])
  @@index([provisionStatus])
  @@map("streaming_servers")
}

// RadioStream status: "off" | "autodj" | "live"

// ================================================================
// Televisión — Video Streaming Models
// ================================================================

// Canal de televisión por cliente
model VideoStream {
  id             String   @id @default(cuid())
  clientId       String   @unique
  serverId       String? // servidor de streaming asignado (televisión)
  status         String   @default("off") // "off" | "autodj" | "live"
  mode           String   @default("playlist") // "playlist" | "schedule"
  shuffle        Boolean  @default(false)
  repeat         Boolean  @default(true)
  autoStart      Boolean  @default(true)
  storageQuotaMB Int? // cuota de almacenamiento en MB
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client                 Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  server                 StreamingServer?        @relation(fields: [serverId], references: [id], onDelete: SetNull)
  videoTracks            VideoTrack[]
  videoPlaylistSchedules VideoPlaylistSchedule[]

  @@index([serverId])
  @@map("video_streams")
}

// Archivos de video subidos
model VideoTrack {
  id            String   @id @default(cuid())
  clientId      String
  videoStreamId String
  title         String   @db.VarChar(191)
  filename      String   @db.VarChar(255)
  filepath      String   @db.VarChar(512)
  filesize      BigInt   @default(0)
  duration      Float    @default(0)
  thumbnail     String?  @db.VarChar(255)
  width         Int?
  height        Int?
  codec         String?  @db.VarChar(31)
  folderId      String?
  createdAt     DateTime @default(now())

  client          Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  videoStream     VideoStream          @relation(fields: [videoStreamId], references: [id], onDelete: Cascade)
  folder          Folder?              @relation(fields: [folderId], references: [id], onDelete: SetNull)
  playlistEntries VideoPlaylistEntry[]

  @@index([clientId])
  @@index([videoStreamId])
  @@index([folderId])
  @@map("video_tracks")
}

// Playlists de video
model VideoPlaylist {
  id        String   @id @default(cuid())
  clientId  String
  name      String   @db.VarChar(191)
  shuffle   Boolean  @default(false)
  repeat    Boolean  @default(true)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  entries   VideoPlaylistEntry[]
  schedules VideoPlaylistSchedule[]

  @@index([clientId])
  @@index([clientId, isActive])
  @@map("video_playlists")
}

// Orden de tracks dentro de una playlist de video
model VideoPlaylistEntry {
  id         String @id @default(cuid())
  clientId   String
  playlistId String
  trackId    String
  position   Int

  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  playlist VideoPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    VideoTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([playlistId, position])
  @@index([trackId])
  @@map("video_playlist_entries")
}

// Programación horaria de playlists de video
model VideoPlaylistSchedule {
  id            String   @id @default(cuid())
  clientId      String
  videoStreamId String
  playlistId    String
  dayOfWeek     Int
  startTime     String   @db.VarChar(191)
  endTime       String   @db.VarChar(191)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  videoStream VideoStream   @relation(fields: [videoStreamId], references: [id], onDelete: Cascade)
  playlist    VideoPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([clientId, dayOfWeek, isActive])
  @@index([videoStreamId, dayOfWeek, isActive])
  @@map("video_playlist_schedules")
}

// ================================================================
// Email — plantillas y log de envíos (Resend)
// ================================================================

// Plantillas de correo editables desde el admin.
// El subject y htmlBody pueden contener variables {{nombre}}, {{plan}},
// {{monto}}, {{fecha}}, {{link}}, {{descripcion}} según el tipo.
model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique // "boleta" | "soporte" | "aviso" | "general"
  name        String // nombre legible para el admin
  description String?  @db.Text
  subject     String // con {{variables}}
  htmlBody    String   @db.Text // HTML con {{variables}}
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  emails EmailLog[]

  @@map("email_templates")
}

// Historial de envíos con rastreo (entregado/abierto/clic vía webhook).
// status: "sent" | "delivered" | "bounced" | "opened" | "clicked" | "failed" | "skipped" | "complained"
model EmailLog {
  id          String    @id @default(cuid())
  clientId    String?
  to          String // destinatario
  from        String // remitente usado
  subject     String
  templateKey String?
  status      String    @default("sent")
  resendId    String? // id devuelto por Resend (para webhook)
  error       String?   @db.Text
  openedAt    DateTime?
  clickedAt   DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  client   Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  template EmailTemplate? @relation(fields: [templateKey], references: [key], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
  @@index([templateKey])
  @@index([resendId])
  @@index([createdAt])
  @@map("email_logs")
}

// Modelos no utilizados eliminados: VideoPlayHistory, EdgeServer, ClientEdgeAssignment
