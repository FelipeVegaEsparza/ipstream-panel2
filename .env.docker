# =====================================================
# IPStream Panel — entorno de desarrollo Docker
# =====================================================
# Este archivo es el que se carga por defecto al hacer `docker compose up`.
# Para producción real, sobrescribí las variables en .env o mediante
# `docker compose --env-file .env.production up`.

# --- Base de datos ---
MYSQL_ROOT_PASSWORD=root_secret_change_me
MYSQL_DATABASE=ipstream_panel
MYSQL_USER=ipstream
MYSQL_PASSWORD=ipstream_secret

# --- App ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-me-in-prod-32chars-minimum
# 32 bytes en hex (64 chars) — usado por lib/encryption.ts (AES-256-GCM)
ENCRYPTION_KEY=326fd50fc31e23b8f2b76a4ceedd16182aa3e7eb4dbdae61ad5c9da0d592851e

NODE_ENV=production

# Admin seed
ADMIN_EMAIL=admin@ipstream.com
ADMIN_PASSWORD=admin123456
ADMIN_NAME=Administrador Principal

# Cron (vacío = sin auth en endpoints de cron, OK en dev)
CRON_SECRET=

# --- Streaming (Icecast) ---
ICE_ADMIN_USER=admin
ICE_ADMIN_PASSWORD=hackme
ICE_SOURCE_PASSWORD=hackme
ICE_RELAY_PASSWORD=hackme
ICE_HOSTNAME=localhost
# Puerto público del stream (lo escuchan los oyentes)
ICE_PUBLIC_PORT=8000

# --- Streaming Agent ---
# Token que el IPStream Panel envía en Authorization: Bearer
STREAMING_AGENT_TOKEN=dev-agent-token-change-me-in-prod
# URL del agent (para el panel)
STREAMING_AGENT_URL=http://agent:4000
# URL pública de Icecast (para que los oyentes se conecten)
# En prod: https://stream.tudominio.com
ICE_PUBLIC_URL=http://localhost:8000
